{
  "name": "jwt-token-refresh-middleware",
  "version": "1.4.2",
  "description": "Automatic JWT refresh middleware for Axios with TypeScript support",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.mjs"
    },
    "./cookie-storage": {
      "types": "./dist/cookie-storage.d.ts",
      "import": "./dist/cookie-storage.mjs",
      "require": "./dist/cookie-storage.js",
      "default": "./dist/cookie-storage.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts src/cookie-storage.ts --format cjs,esm --dts --dts-resolve --clean --splitting false",
    "prepublishOnly": "npm test -- --runInBand && npm run build",
    "prepare": "npm run build",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src"
  },
  "keywords": [
    "axios",
    "jwt",
    "refresh",
    "authentication",
    "typescript",
    "interceptor"
  ],
  "author": "Artem Morozov <artemmor0132@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/artemmorozov13/axios-jwt-refresh-token"
  },
  "bugs": {
    "url": "https://github.com/artemmorozov13/axios-jwt-refresh-token/issues"
  },
  "homepage": "https://github.com/artemmorozov13/axios-jwt-refresh-token#readme",
  "engines": {
    "node": ">=16"
  },
  "peerDependencies": {
    "axios": ">=1.18.0 <2",
    "js-cookie": ">=3.0.6 <4"
  },
  "peerDependenciesMeta": {
    "js-cookie": {
      "optional": true
    }
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "devDependencies": {
    "axios": "^1.19.0",
    "js-cookie": "^3.0.8",
    "@types/js-cookie": "^3.0.3",
    "@types/node": "^20.14.10",
    "@types/jest": "^29.2.3",
    "@typescript-eslint/eslint-plugin": "^5.45.0",
    "@typescript-eslint/parser": "^5.45.0",
    "eslint": "^8.29.0",
    "eslint-config-prettier": "^8.5.0",
    "jest": "^29.3.1",
    "jest-util": "^29.7.0",
    "prettier": "^2.8.0",
    "tsup": "^8.5.0",
    "ts-jest": "^29.0.3",
    "typescript": "^4.9.3"
  }
}
